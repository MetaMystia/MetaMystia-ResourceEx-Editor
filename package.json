{
	"name": "metamystia-resourceex-editor",
	"version": "0.15.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"serve": "pnpx serve out",
		"format": "prettier --cache --write .",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"update": "pnpm up && pnpm dedupe"
	},
	"dependencies": {
		"@heroui/button": "2.2.10",
		"@heroui/card": "2.2.10",
		"@heroui/dropdown": "2.3.10",
		"@heroui/input": "2.4.10",
		"@heroui/modal": "2.2.8",
		"@heroui/navbar": "2.2.9",
		"@heroui/popover": "2.3.10",
		"@heroui/scroll-shadow": "2.3.6",
		"@heroui/select": "2.4.10",
		"@heroui/shared-icons": "2.1.2",
		"@heroui/switch": "2.2.9",
		"@heroui/system": "2.4.7",
		"@heroui/theme": "2.4.6",
		"@heroui/tooltip": "2.2.8",
		"file-saver": "^2.0.5",
		"framer-motion": "12.17.2",
		"jszip": "^3.10.1",
		"next": "^15.5.23",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/file-saver": "^2.0.7",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"postcss": "^8.5.26",
		"postcss-preset-env": "^11.3.2",
		"prettier": "3.8.5",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.102.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@heroui/shared-utils",
			"@parcel/watcher",
			"sharp"
		],
		"overrides": {
			"@react-aria/interactions@^3.22.3": "3.22.2"
		},
		"patchedDependencies": {
			"@heroui/button": "patches/@heroui__button.patch",
			"@heroui/ripple": "patches/@heroui__ripple.patch",
			"@heroui/select": "patches/@heroui__select.patch",
			"@heroui/system-rsc": "patches/@heroui__system-rsc.patch",
			"@heroui/theme": "patches/@heroui__theme.patch",
			"@heroui/tooltip": "patches/@heroui__tooltip.patch",
			"@heroui/use-aria-button": "patches/@heroui__use-aria-button.patch",
			"next": "patches/next.patch"
		},
		"updateConfig": {
			"ignoreDependencies": [
				"framer-motion",
				"@heroui/*",
				"@react-aria/*",
				"@react-stately/*",
				"@react-types/*"
			]
		}
	}
}
